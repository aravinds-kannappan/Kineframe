{
  "name": "mindscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "format": "prettier --write src shared server tests vite.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
